# Variables de entorno necesarias

# Firebase (obligatorias)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Región de las callable Functions de MT-U5a (por defecto: us-central1).
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_ID=

# Notificaciones push (D-NOTIF-02)
# URL absoluta del deployment de Vercel. Vacío en dev/Vercel (mismo origen);
# obligatorio en builds empaquetados sin servidor propio (p. ej. Electron).
NEXT_PUBLIC_APP_URL=
# VAPID key para Firebase Cloud Messaging (obtener de Firebase Console > Messaging).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin SDK (webhooks, server-side operations)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# MT-U5a — secreto de Cloud Functions, no incluir en .env.local ni en el cliente.
# Configurar antes del despliegue: firebase functions:secrets:set OPERATIONAL_PIN_PEPPER

# Wompi (pagos de reservas)
NEXT_PUBLIC_WOMPI_PUB_KEY=
WOMPI_EVENTS_SECRET=

# Landing pública: slug explícito del tenant para el enlace de reservas.
# Si se omite, la landing no muestra un enlace de reserva activo.
NEXT_PUBLIC_RESERVATION_SLUG=

# Factus sandbox (opcional, solo desarrollo local — Electron backend)
# Se usan únicamente para poblar el seed inicial de la BD local en modo desarrollo.
# En producción el operador configura estos valores desde Configuración > Facturación.
FACTUS_SANDBOX_BASE_URL=
FACTUS_SANDBOX_CLIENT_ID=
FACTUS_SANDBOX_CLIENT_SECRET=
FACTUS_SANDBOX_USERNAME=
FACTUS_SANDBOX_PASSWORD=
