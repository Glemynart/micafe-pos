# Variables de entorno necesarias

# Firebase (obligatorias)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_ID=

# Firebase Admin SDK (webhooks, server-side operations)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Wompi (pagos de reservas)
NEXT_PUBLIC_WOMPI_PUB_KEY=
WOMPI_EVENTS_SECRET=

# Factus sandbox (opcional, solo desarrollo local — Electron backend)
# Se usan únicamente para poblar el seed inicial de la BD local en modo desarrollo.
# En producción el operador configura estos valores desde Configuración > Facturación.
FACTUS_SANDBOX_BASE_URL=
FACTUS_SANDBOX_CLIENT_ID=
FACTUS_SANDBOX_CLIENT_SECRET=
FACTUS_SANDBOX_USERNAME=
FACTUS_SANDBOX_PASSWORD=
