{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "firebase-admin/*": ["node_modules/firebase-admin/lib/*/index"],
      "firebase-functions": ["node_modules/firebase-functions/lib/v2/index"],
      "firebase-functions/v2/https": ["node_modules/firebase-functions/lib/v2/providers/https"]
    },
    "outDir": "lib",
    "rootDir": "..",
    "declaration": true
  },
  "include": [
    "src/**/*.ts",
    "../functions/src/tenant-profile/handler.ts",
    "../functions/src/configuracion/service.ts",
    "../functions/src/configuracion/reader.ts",
    "../functions/src/tenant-configuration/authority.ts",
    "../functions/src/contracts.ts",
    "../lib/configuracion/**/*.ts",
    "../lib/impuestos-service.ts",
    "../lib/tenant-roles.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "../functions/src/**/*.test.ts",
    "../lib/configuracion/__tests__/**",
    "../lib/configuracion/client-repository.ts",
    "lib",
    "node_modules"
  ]
}
