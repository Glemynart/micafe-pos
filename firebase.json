{
  "functions": [
    {
      "source": "functions",
      "codebase": "saas-auth"
    },
    {
      "source": "functions-dusema-binding",
      "codebase": "saas-dusema-binding"
    },
    {
      "source": "functions-platform-context",
      "codebase": "saas-platform-context"
    },
    {
      "source": "functions-operator-summary",
      "codebase": "saas-operator-summary"
    },
    {
      "source": "functions-platform-resources",
      "codebase": "saas-platform-resources"
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8085
    },
    "auth": {
      "port": 9099
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
