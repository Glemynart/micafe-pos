{
  "name": "pos-cafe",
  "version": "1.0.0",
  "main": "main.js",
  "private": true,
  "overrides": {
    "jose": "4.15.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glemynart/Mi-Tienda.git"
  },
  "scripts": {
    "dev:next": "next dev -H 0.0.0.0",
    "dev:emu": "cross-env NEXT_PUBLIC_USE_EMULATORS=1 next dev -H 0.0.0.0 -p 3002",
    "emu": "firebase emulators:start --only functions,firestore,auth,storage --project micafe-pos",
    "seed:emu-capa4": "node scripts/seed-emulador-capa4.js",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm run dev:next\" \"npm run dev:electron\"",
    "build": "next build",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "update-server": "node update-server.js",
    "publicar": "powershell -ExecutionPolicy Bypass -File scripts/publicar-update.ps1",
    "lint": "eslint .",
    "seed:usuarios": "tsx scripts/seed-usuarios.ts",
    "test:tickets": "tsx --test lib/tickets/__tests__/*.test.ts",
    "test:reimpresion": "tsx --test lib/reimpresion/__tests__/*.test.ts",
    "test:p1-02:unit": "tsx --test lib/__tests__/configured-line.test.ts lib/__tests__/modifier-selection.test.ts",
    "test:tenant": "tsx --test lib/__tests__/tenant.test.ts",
    "test:membresias": "tsx --test lib/__tests__/membresias.test.ts",
    "test:configuracion": "tsx --test lib/configuracion/__tests__/*.test.ts",
    "test:onboarding": "tsx --test lib/__tests__/onboarding.test.ts",
    "test:backfill": "tsx --test scripts/lib/__tests__/*.test.ts",
    "test:p0-01:verifier": "tsx --test scripts/p0-01/verifier.test.ts",
    "test:p0-01:plan": "tsx --test scripts/plans/mvp-comercial.test.ts",
    "verify:p0-01": "tsx scripts/p0-01/verify-tenant.ts",
    "migrate:configuracion-fundacional": "tsx functions/src/configuracion/migrar-fundacional-cli.ts",
    "analyze:configuracion-legacy": "tsx scripts/analizar-configuracion-legacy.ts --dry-run",
    "install:functions": "npm --prefix functions ci",
    "build:functions": "npm --prefix functions run build",
    "test:auth-foundation": "npm --prefix functions test",
    "test:rules:raw": "node --import tsx firestore-rules/run-tests.ts",
    "test:rules": "firebase --project demo-mt-u4-rules emulators:exec --only firestore \"node --import tsx firestore-rules/run-tests.ts\"",
    "test:storage-rules": "firebase --project demo-p2-03-storage emulators:exec --only storage \"node scripts/storage-rules-runner.mjs\"",
    "test:eventos-publicos": "tsx --test app/api/public/eventos/route.test.ts",
    "test:b3-eventos": "tsx --test scripts/b3/eventos-legacy-inventory.test.ts",
    "test:b3-eventos-backfill": "tsx --test scripts/b3/eventos-legacy-backfill.test.ts",
    "test:email:integration": "node scripts/e2e/email-firestore-integration-runner.mjs",
    "e2e:r1a": "node scripts/e2e/r1a-runner.mjs",
    "e2e:p0-01": "node scripts/e2e/p0-01-runner.mjs",
    "e2e:p0-06": "node scripts/e2e/p0-06-runner.mjs",
    "e2e:p1-02": "node scripts/e2e/p1-02-runner.mjs",
    "e2e:p1-04": "node scripts/e2e/p1-04-runner.mjs",
    "e2e:e4-01": "node scripts/e2e/e4-01-runner.mjs",
    "test:e4-02:contract": "node --test scripts/release/e4-02-contract.test.mjs",
    "test:ci:scope": "node --test scripts/ci/changed-scope.test.mjs",
    "e4-02:readiness": "node scripts/release/e4-02-release-readiness.mjs",
    "e2e:p0-10": "node scripts/e2e/p0-10-runner.mjs",
    "e2e:b2-eventos": "node scripts/e2e/b2-eventos-runner.mjs",
    "e2e:b3-eventos": "node scripts/e2e/b3-eventos-dry-run-runner.mjs",
    "e2e:b3-eventos-backfill": "node scripts/e2e/b3-eventos-backfill-runner.mjs",
    "test:e2e:preflight": "node --test scripts/e2e/emulator-preflight.test.mjs scripts/e2e/e4-01-contract.test.mjs",
    "e2e:ventas:seed": "tsx scripts/e2e/ventas-local-fixture.ts",
    "e2e:r1a:preflight": "tsx scripts/e2e/preflight-r1a.ts",
    "e2e:operator-portal": "node scripts/e2e/operator-portal-runner.mjs"
  },
  "build": {
    "appId": "com.pos.cafe",
    "productName": "MiCafe-POS",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "out/**/*",
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json",
      "credentials.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "MiCafe POS",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Glemynart",
      "repo": "micafe-pos"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-aspect-ratio": "1.1.8",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.7",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.17",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-menubar": "1.1.16",
    "@radix-ui/react-navigation-menu": "1.2.15",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.11",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "@vercel/analytics": "2.0.1",
    "@vis.gl/react-google-maps": "^1.8.3",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "dompurify": "^3.4.11",
    "electron-log": "^5.4.4",
    "electron-serve": "^3.0.1",
    "electron-updater": "^6.8.3",
    "embla-carousel-react": "8.6.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.0.0",
    "googleapis": "^173.0.0",
    "input-otp": "1.4.2",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.564.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-day-picker": "9.13.2",
    "react-dom": "^19",
    "react-hook-form": "^7.54.1",
    "react-leaflet": "^5.0.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "3.8.1",
    "sonner": "^1.7.1",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^8.3.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dotenv": "^16.6.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.24.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.66.0",
    "wait-on": "^9.0.5"
  }
}
