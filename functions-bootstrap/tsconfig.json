{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "firebase-admin/*": ["node_modules/firebase-admin/lib/*/index"],
      "firebase-functions": ["node_modules/firebase-functions/lib/v2/index"],
      "firebase-functions/params": ["node_modules/firebase-functions/lib/params/index"],
      "firebase-functions/v2/https": ["node_modules/firebase-functions/lib/v2/providers/https"],
      "bcryptjs": ["node_modules/bcryptjs/index"]
    },
    "outDir": "lib",
    "rootDir": "..",
    "declaration": true
  },
  "include": [
    "src/**/*.ts",
    "../functions/src/bootstrap/shared.ts",
    "../functions/src/suscripciones/ofertas-tenant.ts",
    "../lib/bootstrap/contrato.ts"
  ],
  "exclude": ["src/**/*.test.ts", "lib", "node_modules"]
}
