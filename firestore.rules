rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // El claim tenant es emitido exclusivamente por Functions desde la
    // membresía canónica. Ningún cliente puede escribir roles o permisos.
    function haySesion() { return request.auth != null; }
    function esSesionActivacion() {
      return haySesion()
        && request.auth.token.keys().hasAll(['authStage'])
        && request.auth.token.authStage == 'DIRECTA_TEMP';
    }
    function esAutenticado() { return haySesion() && !esSesionActivacion(); }
    function rol() { return request.auth.token.rol; }
    function esAdmin() { return esAutenticado() && rol() == 'admin'; }
    function esCajero() { return esAutenticado() && rol() == 'cajero'; }
    function esVendedor() { return esAutenticado() && rol() == 'vendedor'; }
    function esSupervisor() { return esAutenticado() && rol() == 'supervisor'; }
    function esCocinero() { return esAutenticado() && rol() == 'cocinero'; }
    function esMarketing() { return esAutenticado() && rol() == 'marketing'; }
    function esAdminOCajero() { return esAdmin() || esCajero(); }
    function esOperativo() { return esAdmin() || esCajero() || esSupervisor(); }
    function esCocina() { return esAdmin() || esCajero() || esCocinero(); }

    function tieneEmpresaId() {
      return esAutenticado() && request.auth.token.empresaId is string;
    }
    function perteneceTenantDelRecurso() {
      return tieneEmpresaId()
        && resource.data.empresaId == request.auth.token.empresaId;
    }
    function perteneceTenantDeLaEscritura() {
      return tieneEmpresaId()
        && request.resource.data.empresaId == request.auth.token.empresaId;
    }
    function conservaEmpresaId() {
      return perteneceTenantDelRecurso()
        && request.resource.data.empresaId == resource.data.empresaId;
    }

    // Directiva B4 — Enforcement Canónico de Empresa.estado
    // La autoridad única para conceder o denegar acceso operacional es Empresa.estado.
    function estadoEmpresa() {
      return get(/databases/$(database)/documents/empresas/$(request.auth.token.empresaId)).data.estado;
    }
    function empresaEscribible() {
      return tieneEmpresaId() && estadoEmpresa() in ['trial', 'activa'];
    }
    function empresaLecturaAdmin() {
      return tieneEmpresaId() && (
        estadoEmpresa() in ['trial', 'activa'] ||
        (estadoEmpresa() == 'suspendida' && esAdmin())
      );
    }

    function puedeLeerTenant() {
      return perteneceTenantDelRecurso() && empresaLecturaAdmin();
    }
    function puedeCrearEnTenant() {
      return perteneceTenantDeLaEscritura() && empresaEscribible();
    }
    function puedeActualizarEnTenant() {
      return perteneceTenantDeLaEscritura() && conservaEmpresaId() && empresaEscribible();
    }
    function puedeEliminarEnTenant() {
      return perteneceTenantDelRecurso() && empresaEscribible();
    }
    // ADR-SAAS-052: Bodega administra categorías mediante la callable
    // server-authoritative; los verticales legacy conservan su contrato actual.
    function esBodegaMvp1() {
      return tieneEmpresaId()
        && exists(/databases/$(database)/documents/configuraciones/$(request.auth.token.empresaId))
        && get(/databases/$(database)/documents/configuraciones/$(request.auth.token.empresaId)).data.vertical == 'BODEGA_MVP1';
    }
    // ADR-SAAS-077: las restricciones de lectura del vendedor son específicas
    // de Bodega; GENERAL conserva las lecturas directas que usa POS LEGACY.
    function esVendedorBodegaMvp1() {
      return esVendedor() && esBodegaMvp1();
    }
    // ADR-SAAS-081: la misma autoridad canónica que leen las callables de
    // compra cierra también los escritores directos durante el corte. La
    // ausencia o forma inválida del control niega por defecto.
    function comprasHabilitadasParaTenant() {
      let control = /databases/$(database)/documents/controles_release_compras/$(request.auth.token.empresaId);
      return tieneEmpresaId()
        && exists(control)
        && get(control).data.schemaVersion is int
        && get(control).data.schemaVersion == 1
        && get(control).data.empresaId == request.auth.token.empresaId
        && get(control).data.estado == 'ACTIVA'
        && get(control).data.revision is int
        && get(control).data.revision >= 1
        // Mantiene el mismo límite que Number.isSafeInteger en las Functions:
        // una revisión activa debe poder incrementarse para pausar el control.
        && get(control).data.revision < 9007199254740991;
    }
    function membresiaBodegaActiva(empresaId, permiso) {
      let path = /databases/$(database)/documents/membresias/$(empresaId + '_' + request.auth.uid);
      return tieneEmpresaId()
        && request.auth.token.empresaId == empresaId
        && empresaEscribible()
        && esBodegaMvp1()
        && exists(path)
        && get(path).data.empresaId == empresaId
        && get(path).data.uid == request.auth.uid
        && get(path).data.estado == 'activa'
        && get(path).data.activo == true
        && get(path).data.rol == rol()
        && get(path).data.permisos is list
        && permiso in get(path).data.permisos;
    }
    function esUsuarioPropio(uid) {
      return esAutenticado() && request.auth.uid == uid;
    }

    match /espacios/{id} {
      allow read: if puedeLeerTenant() && esAutenticado();
      allow create: if puedeCrearEnTenant() && esAdmin();
      allow update: if puedeActualizarEnTenant() && esAdmin();
      allow delete: if puedeEliminarEnTenant() && esAdmin();
    }
    match /categorias/{id} {
      allow read: if puedeLeerTenant() && esAutenticado();
      allow create: if !esBodegaMvp1() && puedeCrearEnTenant() && esAdmin();
      allow update: if !esBodegaMvp1() && puedeActualizarEnTenant() && esAdmin();
      allow delete: if !esBodegaMvp1() && puedeEliminarEnTenant() && esAdmin();
    }
    match /productos/{id} {
      allow read: if puedeLeerTenant() && esAutenticado() && !esVendedorBodegaMvp1();
      // En Bodega el catálogo es callable-only para el vendedor; los verticales
      // legacy conservan su lectura directa, siempre tenant-aware.
      allow create, update, delete: if false;
    }
    match /presentaciones_producto/{id} {
      // Bodega U2-B: el vendedor consume únicamente la proyección callable
      // sanitizada. Las altas, precios y estados se mutan solo por Functions.
      allow read: if puedeLeerTenant() && esAutenticado() && !esVendedor();
      allow create, update, delete: if false;
    }
    match /insumos/{id} {
      allow read: if puedeLeerTenant() && esAutenticado();
      allow create, update, delete: if false;
    }
    match /recetas/{id} {
      allow read: if puedeLeerTenant() && esAutenticado();
      allow create: if puedeCrearEnTenant() && esOperativo();
      allow update: if puedeActualizarEnTenant() && esOperativo();
      allow delete: if puedeEliminarEnTenant() && esOperativo();
    }
    match /mesas/{id} {
      allow read: if puedeLeerTenant() && esAutenticado();
      allow create: if puedeCrearEnTenant() && esAdmin();
      allow update: if puedeActualizarEnTenant() && esAdmin();
      allow delete: if puedeEliminarEnTenant() && esAdmin();
    }
    match /pedidos_activos/{id} {
      allow read: if puedeLeerTenant() && esAdminOCajero();
      // Las mutaciones operativas pasan exclusivamente por Functions/Admin SDK.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
    match /comandas_cocina/{id} {
      allow read: if puedeLeerTenant() && esCocina();
      // Caja y cocina expresan intención mediante las callables de salón.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
    match /ventas/{id} {
      allow read: if puedeLeerTenant() && esAutenticado() && !esVendedorBodegaMvp1();
      allow create: if false;
      // La Fase 2 es server-authoritative: inventario, tesorería,
      // idempotencia y auditoría deben confirmarse en una transacción Admin
      // SDK. El cliente no puede marcar una venta como COMPLETO para saltarse
      // esos efectos aunque conserve el snapshot fiscal.
      allow update: if false;
      allow delete: if false;
    }
    match /turnos/{id} {
      allow read: if puedeLeerTenant() && esAutenticado()
        && (!esVendedorBodegaMvp1() || resource.data.cajeroId == request.auth.uid);
      allow create: if puedeCrearEnTenant() && esOperativo();
      allow update: if puedeActualizarEnTenant() && esOperativo();
      allow delete: if false;
    }
    match /turnos_activos/{id} {
      allow read: if puedeLeerTenant() && esAutenticado();
      allow create: if puedeCrearEnTenant() && esOperativo();
      allow update: if puedeActualizarEnTenant() && esOperativo();
      allow delete: if puedeEliminarEnTenant() && esOperativo();
    }

    // R1-A: evidencia de comandos y auditoría crítica. Estas colecciones son
    // exclusivas del backend Admin SDK durante la transición de turnos.
    match /operaciones_comandos/{id} {
      allow read, write: if false;
    }
    match /operaciones_command_idempotency/{id} {
      allow read, write: if false;
    }
    match /operaciones_auditoria/{id} {
      allow read, write: if false;
    }

    // Reservas públicas: la landing opera exclusivamente por rutas Admin SDK.
    match /reservas/{id} {
      allow read: if puedeLeerTenant() && esAutenticado();
      allow create, update: if false;
      allow delete: if false;
    }
    match /agendas/{id} {
      allow read: if puedeLeerTenant() && esAutenticado();
      allow create, update: if false;
      allow delete: if false;
    }
    match /reservas_operaciones/{id} {
      allow read, write: if false;
    }
    match /intenciones_pago_reserva/{id} {
      allow read, write: if false;
    }

    match /compras/{id} {
      allow read: if puedeLeerTenant() && esAutenticado();
      // ADR-SAAS-072: Bodega registra compras solo por su callable canónica;
      // los demás verticales conservan temporalmente la ruta legacy.
      allow create: if !esBodegaMvp1() && comprasHabilitadasParaTenant() && puedeCrearEnTenant() && esAdmin();
      allow update: if false;
      allow delete: if !esBodegaMvp1() && comprasHabilitadasParaTenant() && puedeEliminarEnTenant() && esAdmin();
    }
    match /controles_release_compras/{id} {
      allow read, write: if false;
    }
    // El catalogo se escribe exclusivamente mediante las callables de
    // Proveedores; el cliente solo puede leer datos de su tenant.
    match /proveedores/{id} {
      allow read: if puedeLeerTenant() && esAutenticado();
      allow create, update, delete: if false;
    }
    match /mermas/{id} {
      allow read: if puedeLeerTenant() && esAutenticado();
      // La merma y su salida de kardex se escriben juntas por callable.
      allow create, update, delete: if false;
    }
    match /egresos/{id} {
      allow read: if puedeLeerTenant() && esAutenticado();
      // Los egresos se crean y corrigen exclusivamente mediante la callable
      // registrarEgresoOperativoV1, que conserva el hecho financiero atómico.
      allow create, update: if false;
      // El egreso y su movimiento financiero son append-only. Las correcciones
      // requieren una operación backend canónica; el cliente no puede borrar.
      allow delete: if false;
    }
    match /clientes/{id} {
      // Bodega MVP-1: vendedor consulta clientes activos exclusivamente por
      // callable con DTO fijo; así no puede leer documentos completos ni
      // cambiar de tenant mediante una consulta directa.
      allow read: if puedeLeerTenant() && esAutenticado() && !esVendedorBodegaMvp1();
      allow create: if puedeCrearEnTenant() && esOperativo();
      allow update: if puedeActualizarEnTenant() && esOperativo();
      allow delete: if puedeEliminarEnTenant() && esOperativo();
    }
    match /cuentas_bancarias/{id} {
      allow read: if puedeLeerTenant() && esOperativo();
      allow create, update, delete: if false;
    }
    match /transacciones_financieras/{id} {
      allow read: if puedeLeerTenant() && esAdmin();
      allow create: if false;
      allow update, delete: if false;
    }
    match /liquidaciones/{id} {
      allow read: if puedeLeerTenant() && esAutenticado();
      allow create: if puedeCrearEnTenant() && esAdmin();
      allow update: if puedeActualizarEnTenant() && esAdmin();
      allow delete: if puedeEliminarEnTenant() && esAdmin();
    }
    match /consignadores/{id} {
      allow read: if puedeLeerTenant() && esAutenticado();
      allow create: if puedeCrearEnTenant() && esAdmin();
      allow update: if puedeActualizarEnTenant() && esAdmin();
      allow delete: if puedeEliminarEnTenant() && esAdmin();
    }
    match /movimientos_inventario/{id} {
      // El vendedor no puede leer el ledger: contiene costos internos.
      allow read: if puedeLeerTenant() && esAutenticado() && !esVendedor();
      allow create, update, delete: if false;
    }
    match /auditoria_logs/{id} {
      allow read: if puedeLeerTenant() && esAdmin();
      allow create: if puedeCrearEnTenant()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /modificador_grupos/{id} {
      allow read: if puedeLeerTenant() && esAutenticado();
      allow create: if puedeCrearEnTenant() && esAdminOCajero();
      allow update: if puedeActualizarEnTenant() && esAdminOCajero();
      allow delete: if puedeEliminarEnTenant() && esAdminOCajero();
    }
    match /producto_modificador_grupos/{id} {
      allow read: if puedeLeerTenant() && esAutenticado();
      allow create: if puedeCrearEnTenant() && esAdminOCajero();
      allow update: if puedeActualizarEnTenant() && esAdminOCajero();
      allow delete: if puedeEliminarEnTenant() && esAdminOCajero();
    }

    // Contenido público propiedad de tenant. La lectura pública se realiza
    // exclusivamente mediante el endpoint server-side de B2; ningún cliente
    // anónimo puede consultar la colección global directamente.
    match /eventos/{id} {
      allow read: if puedeLeerTenant() && esAutenticado();
      allow create: if puedeCrearEnTenant()
        && rol() in ['admin', 'marketing']
        && request.resource.data.empresaId is string;
      allow update: if puedeActualizarEnTenant()
        && rol() in ['admin', 'marketing'];
      allow delete: if puedeEliminarEnTenant()
        && rol() in ['admin', 'marketing'];
    }
    match /configuracion/{id} {
      // MT-B7: archivo histórico. Ningún cliente puede resolver configuración
      // tenant mediante el singleton legacy.
      allow read: if false;
      allow create, update, delete: if false;
    }
    match /usuarios/{uid} {
      // Perfil global: nunca contiene ni decide rol, permisos o estado.
      // Un perfil no lleva empresaId porque una identidad puede pertenecer a
      // varios tenants. Por ello ningún cliente puede listar ni leer perfiles
      // de terceros: los directorios administrativos se resuelven únicamente
      // en backend desde las membresías canónicas del tenant.
      allow get: if esUsuarioPropio(uid);
      allow list: if false;
      allow create, delete: if false;
      allow update: if esUsuarioPropio(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoAcceso', 'fcmTokens']);
    }
    match /permisos_roles/{id} {
      // Plantillas: solo base de alta/sincronización por backend Admin SDK.
      allow read, write: if false;
    }

    // Plano SaaS: las operaciones se reservan al claim de plataforma; el
    // backend Admin SDK lo administra sin depender de Rules.
    match /empresas/{empresaId} {
      allow get: if tieneEmpresaId() && request.auth.token.empresaId == empresaId;
      allow list: if false;
      // Empresa.estado solo transiciona mediante el servicio backend canónico.
      allow create, update, delete: if false;
    }
    match /empresas/{empresaId}/bodega_senales/{canal} {
      // Señales técnicas; los datos de negocio siguen siendo callable-only.
      allow get: if canal == 'disponibilidad'
          && esVendedor()
          && membresiaBodegaActiva(empresaId, 'sell')
        || canal == 'solicitudes_admin'
          && esAdmin()
          && membresiaBodegaActiva(empresaId, 'sell');
      allow list, create, update, delete: if false;
    }
    match /empresas/{empresaId}/bodega_senales_vendedor/{signalId} {
      // La ruta se resuelve por UID; no se permite enumerar la colección.
      allow get: if esVendedor()
        && membresiaBodegaActiva(empresaId, 'sell')
        && signalId == request.auth.uid;
      allow list, create, update, delete: if false;
    }
    match /membresias/{id} {
      // La membresía es la autoridad tenant. Cada usuario solo lee la propia;
      // un admin lista las de su empresa. Toda escritura pasa por Functions para
      // sincronizar/revocar custom claims.
      allow get: if perteneceTenantDelRecurso()
        && (resource.data.uid == request.auth.uid || esAdmin());
      allow list: if perteneceTenantDelRecurso() && esAdmin();
      allow create, update, delete: if false;
    }
    match /planes/{id} {
      allow read, write: if false;
    }
    match /suscripciones/{id} {
      allow read: if false;
      allow write: if false;
    }
    match /suscripciones/{empresaId}/relaciones/{relacionId} {
      // Relaciones contractuales y snapshots: solo comandos server-side.
      allow read, write: if false;
    }
    // MT-U9: recibos de pago SaaS append-only del backend; nunca se exponen al
    // cliente tenant ni se aceptan escrituras directas.
    match /pagos_saas/{id} {
      allow read, write: if false;
    }
    match /invitaciones/{id} {
      allow read, write: if false;
    }
    match /incorporaciones/{id} {
      allow read, write: if false;
    }
    match /consumo/{id} {
      allow read, write: if false;
    }
    match /saas_operadores/{uid} {
      allow read, write: if false;
    }
    match /saas_auditoria/{id} {
      allow read, write: if false;
    }
    match /saas_auditoria_obligaciones/{id} {
      allow read, write: if false;
    }
    match /saas_soporte_autorizaciones/{id} {
      allow read, write: if false;
    }
    match /saas_comandos/{id} {
      allow read, write: if false;
    }
    match /provisionamientos_empresariales/{id} {
      allow read, write: if false;
    }
    match /saas_platform_bindings/{id} {
      allow read, write: if false;
    }
    match /saas_platform_binding_external_tenants/{id} {
      allow read, write: if false;
    }

    // Colecciones futuras de MT-U6: no tienen consumidor cliente todavÃ­a.
    // Se bloquean para tenants y quedan disponibles solo al plano plataforma.
    match /configuraciones/{empresaId} {
      allow read, write: if false;
    }
    match /numeraciones/{id} {
      allow read: if puedeLeerTenant() && esAutenticado();
      allow write: if false;
    }
    match /asignaciones_numeracion/{id} {
      allow read: if puedeLeerTenant() && esAutenticado();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
