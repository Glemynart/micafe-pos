rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Auditoría: solo crear (append-only, nadie lee directo) ───
    match /auditoria_logs/{id} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
      allow create: if request.auth != null
        && request.resource.data.accion is string
        && request.resource.data.detalle is string
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(["accion", "detalle", "uid", "timestamp"]);
      allow update, delete: if false;
    }

    // ─── Landing: lectura pública ───
    match /eventos/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['admin', 'marketing']
        && request.resource.data.titulo is string
        && request.resource.data.fecha is string;
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['admin', 'marketing'];
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // ─── Landing: lectura pública ───
    match /configuracion/{id} {
      allow read: if true;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // ─── Usuarios: solo el propio usuario o admin ───
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    match /permisos_roles/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // ─── Operaciones: solo admin escribe, autenticados leen ───
    match /compras/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
      allow update, delete: if false;
    }

    match /mermas/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
      allow update, delete: if false;
    }

    match /ventas/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
      allow delete: if false;
    }

    match /turnos/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
      allow delete: if false;
    }

    match /productos/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    match /insumos/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    match /recetas/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /mesas/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /pedidos_activos/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /comandas_cocina/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /clientes/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /espacios/{id} {
      allow read: if true;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    match /categorias/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /consignadores/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /liquidaciones/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /egresos/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /cuentas_bancarias/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /transacciones/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /reservas/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ─── Fallback: bloquear todo lo demás ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
