{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "firebase-admin/*": ["node_modules/firebase-admin/lib/*/index"],
      "firebase-functions/v2/https": ["node_modules/firebase-functions/lib/v2/providers/https"]
    },
    "outDir": "lib",
    "rootDir": "..",
    "declaration": true
  },
  "include": [
    "src/**/*.ts",
    "../functions/src/bodega/operational-core.ts",
    "../functions/src/bodega-vendedor/clientes.ts",
    "../functions/src/bodega-vendedor/presentaciones.ts",
    "../functions/src/bodega-vendedor/ventas-authority.ts",
    "../functions/src/bodega-vendedor/ventas-confirmation.ts",
    "../functions/src/bodega-vendedor/ventas-contract.ts",
    "../functions/src/bodega-vendedor/ventas-resolution.ts",
    "../functions/src/inventario/callables.ts",
    "../functions/src/inventario/ledger.ts",
    "../functions/src/tenant-configuration/authority.ts",
    "../functions/src/configuracion/reader.ts",
    "../functions/src/turnos/executor.ts",
    "../functions/src/turnos/identificadores.ts",
    "../functions/src/contracts.ts",
    "../lib/configuracion/contrato.ts",
    "../lib/configuracion/validacion.ts"
  ],
  "exclude": ["src/**/*.test.ts", "../functions/src/**/*.test.ts", "lib", "node_modules"]
}
